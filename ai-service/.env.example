HOST=0.0.0.0
PORT=8081
LOG_LEVEL=INFO
AI_WEBHOOK_SECRET=dev-secret-change-in-prod
LOCAL_STORAGE_DIR=/app/videos
ANALYSIS_FPS=2.0
WEBHOOK_TIMEOUT_SECONDS=15
WEBHOOK_MAX_RETRIES=2
WEBHOOK_RETRY_BACKOFF_SECONDS=1.5
YOLO_MODEL_PATH=./yolov8n-pose.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
RF_MODEL_PATH=./models/bjj_pose_classifier.pkl
RF_LABEL_MAPPING_PATH=./models/label_mapping.json
MAX_FRAMES_PER_VIDEO=0
PYTHON_PARITY_MODE=true
SPRING_POC_ENABLED=true
SPRING_POC_BASE_URL=http://localhost:8090
SPRING_POC_TIMEOUT_SECONDS=300
SPRING_POC_POLL_INTERVAL_SECONDS=2
SPRING_POC_MAX_WAIT_SECONDS=300
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
